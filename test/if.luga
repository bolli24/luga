fn takes_i8(value: i8) : void {
}

fn main() {
    let a = 5;
    let b = 2;
    let c = a + b * 3;   // c = 5 + 6 = 11
    let d = c - a;       // d = 11 - 5 = 6
    let e = d / b;       // e = 6 / 2 = 3

    if c == 11 then {
        a = a * 2;       // a = 10
        @print("Level 1: a = %d\n", a);

        if d == 6 then {
            b = b + a;   // b = 2 + 10 = 12
            @print("Level 2: b = %d\n", b);

            if e == 3 then {
                c = c + b;   // c = 11 + 12 = 23
                @print("Level 3: c = %d\n", c);
            } else {
                c = c - b;
                @print("Level 3 Else: c = %d\n", c);
            }
        } else if true then {
            d = d * 2;
            @print("Level 2 Else: d = %d\n", d);
        } else {
            @print("never");
        }
    } else {
        a = 0;
        @print("Outer Else: a reset to %d\n", a);

        if b == 2 then {
            b = b * 5;
            @print("Else Nested: b = %d\n", b);
        }
    }

    let expr = if a > 6 then {
        = "good";
    } else {
        = "bad";
    };

    @println("%s", expr);

    let amount = if a > 6 then {
        = 7;
    } else {
        @exit(-1); // Unreachable
    };

    @println("%d", amount);

    takes_i8(if a > 6 then {
        = 1;
    } else {
        = 2;
    });
}
