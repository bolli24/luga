struct iVec {
    x: i32;
    y: i32;
} {
    fn add(this: iVec, other: iVec) : iVec {
        return iVec {x: this.x + other.x, y: this.y + other.y};
    }

    fn zero() : iVec {
        return iVec {x: 0, y: 0};
    } 
}

fn printVec(vec: iVec) {
    @println("(%d, %d)", vec.x, vec.y);
}

// struct declared inside a function scope
fn sumComponents() : i32 {
    struct Pair {
        a: i32;
        b: i32;
    }
    let p = Pair {a: 10, b: 32};
    return p.a + p.b;
}

fn main() {
    let a = iVec {x: 2, y: -2};
    let b = iVec {x: -2, y: -2};

    printVec(iVec {x: 0, y: -4});

    let c = iVec.add(a, b);

    printVec(c);

    @assert(0 == c.x);
    @assert(-4 == c.y);

    @assert(sumComponents() == 42);

    let zero = iVec.zero();
    @assert(0 == zero.x);
    @assert(0 == zero.y);
}
