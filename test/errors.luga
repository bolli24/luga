/// SKIP_TEST

fn main() {
    var test = "error" + 2;

    var b = test;
    var c = 2 * test;
    var d = !test;
    var e = (d == c) == (b == test);

    if c == b + test then {
        @println(test);
    }

    if !d then {
        var nested = e + 1;
        @println(nested);
    }

    while test {
        @println("unreachable");
    }

    takes_i32(test);
}

fn takes_i32(value: i32) {
    @println("{}", value);
}

fn returns_i32() : i32 {
    var broken = "error" + 2;
    return broken;
}
