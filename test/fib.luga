fn fibonacci(number: i32) : i32 {
    if (number < 2) {
        return number;
    } else {
        return fibonacci(number - 1) + fibonacci(number - 2);
    }
}

fn less(number: i32) : bool {
    if (number < 2) {
        @print("Yes!");
        return true;
    } else {
        @print("NOOOO!");
        return false;
    }
}

fn main() {
    @print("%d", fibonacci(10));
    @assert(fibonacci(10) == 55);
}
