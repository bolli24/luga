fn fibonacci(n: i32) : i32 {
    if n <= 1 then {
        return 0;
    }

    var a = 0;
    var b = 1;
    var i = 2;

    while i < n + 1 {
        var c = b;
        b = a + b;
        a = c;

        i = i + 1;
    }

    return b;
}

fn main() {
    @print("%d", fibonacci(10));
    @assert(fibonacci(10) == 55);
}
