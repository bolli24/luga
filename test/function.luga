fn hallo(test: string, number: i32) {
    @print("%s ", test);
    @println("%d", number);
}

fn halloAlso() {
   @println("Hello from me too.");
}

hallo("Hello world.", 10);
halloAlso();

// nested function: inner is only visible inside outer
fn applyTwice(x: i32) : i32 {
    fn double(n: i32) : i32 {
        return n * 2;
    }
    return double(double(x));
}

@assert(applyTwice(3) == 12);
@assert(applyTwice(0) == 0);
@assert(applyTwice(1) == 4);
