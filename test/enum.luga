enum Direction {
    Up, Down, Left, Right,
}

enum Color {
    Red, Green, Blue,
}

fn isRed(c: Color) : bool {
    return c == Color.Red;
}

fn dirName(d: Direction) : string {
    if d == Direction.Up then   { return "up"; }
    if d == Direction.Down then { return "down"; }
    if d == Direction.Left then { return "left"; }
    return "right";
}

// enum declared inside a function scope
fn classifyColor(c: Color) : i32 {
    enum Warmth { Cool, Warm, }
    let w = Warmth.Warm;
    if c == Color.Blue then { w = Warmth.Cool; }
    return @enumToInt(w);
}

fn main() {
    // index values are 0-based in declaration order
    let up    = Direction.Up;
    let down  = Direction.Down;
    let left  = Direction.Left;
    let right = Direction.Right;

    @assert(@enumToInt(up)    == 0);
    @assert(@enumToInt(down)  == 1);
    @assert(@enumToInt(left)  == 2);
    @assert(@enumToInt(right) == 3);

    @assert(up    == Direction.Up);
    @assert(down  == Direction.Down);
    @assert(left  == Direction.Left);
    @assert(right == Direction.Right);

    @assert(up != down);
    @assert(left != right);
    @assert(up != right);
    @assert(!(up != up));

    // assignment and reassignment
    let dir = Direction.Left;
    @assert(dir == Direction.Left);
    dir = Direction.Right;
    @assert(dir == Direction.Right);

    // passing enum to a function
    @assert(isRed(Color.Red));
    @assert(!isRed(Color.Green));
    @assert(!isRed(Color.Blue));

    // enum in a conditional
    @println("dirName(Up):    %s", dirName(Direction.Up));
    @println("dirName(Right): %s", dirName(Direction.Right));

    @assert(classifyColor(Color.Red)  == 1);
    @assert(classifyColor(Color.Blue) == 0);
}
