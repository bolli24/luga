/// SKIP_TEST

struct Color {
    r: u8;
    g: u8;
    b: u8;
    a: u8;
}

fn color(r: u8, g: u8, b: u8) : Color {
    return Color {r: r, g: g, b: b, a: 255};
}

extern fn InitWindow(width: i32, height: i32, title: string);
extern fn CloseWindow();
extern fn SetTargetFPS(fps: i32);
extern fn WindowShouldClose() : bool;
extern fn BeginDrawing();
extern fn EndDrawing();
extern fn ClearBackground(color: i32);
extern fn DrawText(text: string, x: i32, y: i32, size: i32, color: Color);
extern fn DrawFPS(x: i32, y: i32);

let screenWidth = 800;
let screenHeight = 600;

InitWindow(screenWidth, screenHeight, "luga x raylib");

SetTargetFPS(60);

let col = color(74, 255, 122);

@println("%hhu, %hhu, %hhu, %hhu", col.r, col.g, col.b, col.a);


while (!WindowShouldClose()) {
    BeginDrawing();

    ClearBackground(0);

    DrawText("Hello from luga.", 190, 200, 50, col);
    DrawFPS(0, 0);

    EndDrawing();
}


CloseWindow();
