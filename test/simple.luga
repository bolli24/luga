fn main(): i32 {
    {
        let pi = 3;
        let tau = 2 * pi;
        tau = 6;

        {
            @print("pi: %d \n", pi);
            @print("tau: %d\n", tau);
        }

        {
            let x = pi + tau;
            @print("x: %d\n", x);
        }

        let test = {
            =pi + tau;
        };

        @print("test: %d\n", test);
    }

    return 3 * (4 * 4 + 4) + 3 * 3;
}
