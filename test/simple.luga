fn iabs(ref x: i32) {
    if x < 0 then {
        x = 0-x;
    } else {
        x = x;
    }
}

struct Pos {
    x: i32,
    y: i32,
} {
    fn print(ref pos: Pos) {
        @println("(%d, %d)", pos.x, pos.y);
    }

    fn copy(pos: Pos) : Pos {
        = pos;
    }
    
    fn abs(ref this: Pos) {
        iabs(ref this.x);
        iabs(ref this.y);
    }
}

fn main() {
    var a = Pos {x: 1, y: -4};
    test(ref a.x);

    var b = a.copy();
    b.x = 4;

    a.print();
    b.print();
    a.abs();
    a.print();
}

fn test(ref x: i32) {
    x = x + 2;
}

